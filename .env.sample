# Скопируйте в .env и впишите ключи. Остальные значения по умолчанию —
# в settings.py; сюда выносите только то, что нужно переопределить.

# Движок разговора с аватаром (llm_service) ходит в OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-plus
# Модель только для разговора с аватаром. Пусто — OPENROUTER_MODEL.
AVATAR_MODEL=
# Необязательно: HTTP-прокси к провайдеру моделей.
LLM_HTTP_PROXY=

# Голос аватара (GPT Live), распознавание и озвучка речи — через OpenAI.
OPENAI_API_KEY=

# Демо-учитель, которого заводит seed при первом запуске.
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=english-demo-2026

# Часовой пояс школы: срок домашней работы — конец выбранного дня в нём.
SCHOOL_TZ=Europe/Moscow
